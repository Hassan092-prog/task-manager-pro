# Docker Compose Environment Configuration
# Copy this file to .env before running docker compose (optional)

# Backend Security Keys
SECRET_KEY=generate-a-secure-random-secret-key-here
JWT_SECRET_KEY=generate-a-secure-random-jwt-key-here

# Database Selection (Default: SQLite with persistent Docker volume)
DATABASE_URL=sqlite:///taskmanager.db

# To use PostgreSQL container:
# 1. Start with: docker compose --profile postgres up -d
# 2. Uncomment the line below:
# DATABASE_URL=postgresql://taskuser:taskpass@db:5432/taskmanager
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskmanager
