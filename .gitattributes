# Default line ending rule for text files
* text=auto eol=lf

# Explicit syntax enforcement
*.py text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.html text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.svg binary
*.ico binary
*.woff2 binary
*.db binary

